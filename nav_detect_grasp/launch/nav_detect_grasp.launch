<launch>
    <!-- Navigation, Detection and Grasp Demo Launch File -->
    
    <!-- Output log format -->
    <env name="ROSCONSOLE_FORMAT" value="[${severity} ][${time:%Y-%m-%d-%H:%M:%S}][${node}]: ${message}"/>
    
    <!-- Arguments -->
    <arg name="robot_version" default="$(optenv ROBOT_VERSION 45)"/>
    <arg name="use_simulation" default="false"/>
    <arg name="use_camera" default="true"/>
    <arg name="camera_type" default="gemini"/>
    <arg name="use_apriltag_detection" default="true"/>
    <arg name="use_yolo_detection" default="true"/>
    <arg name="use_visualization" default="true"/>
    <arg name="nav_config" default="$(find nav_detect_grasp)/config/navigation_params.yaml"/>
    <arg name="detection_config" default="$(find nav_detect_grasp)/config/detection_params.yaml"/>
    <arg name="grasp_config" default="$(find nav_detect_grasp)/config/grasp_params.yaml"/>
    
    <!-- Load robot version manager -->
    <include file="$(find humanoid_controllers)/launch/robot_version_manager.launch">
        <arg name="robot_version" value="$(arg robot_version)"/>
        <arg name="rviz" value="$(arg use_visualization)"/>
    </include>
    
    <!-- Launch robot controller -->
    <group if="$(arg use_simulation)">
        <!-- Simulation mode -->
        <include file="$(find humanoid_controllers)/launch/load_kuavo_mujoco_sim.launch">
            <arg name="use_joystick" value="false"/>
        </include>
    </group>
    
    <group unless="$(arg use_simulation)">
        <!-- Real robot mode -->
        <include file="$(find humanoid_controllers)/launch/load_kuavo_real.launch">
            <arg name="use_joystick" value="false"/>
            <arg name="ruiwo_cxx_sdk" value="true"/>
        </include>
    </group>
    
    <!-- Launch camera nodes -->
    <group if="$(arg use_camera)">
        <group if="$(eval arg('camera_type') == 'realsense')">
            <!-- RealSense camera -->
            <include file="$(find realsense2_camera)/launch/rs_camera.launch">
                <arg name="camera_name" value="head_camera"/>
                <arg name="color_width" value="1280"/>
                <arg name="color_height" value="720"/>
                <arg name="color_fps" value="30"/>
            </include>
        </group>
        
        <group if="$(eval arg('camera_type') == 'zed')">
            <!-- ZED camera -->
            <include file="$(find zed_wrapper)/launch/zed2.launch">
                <arg name="resolution" value="HD720"/>
                <arg name="frame_rate" value="30"/>
            </include>
        </group>
        
        <group if="$(eval arg('camera_type') == 'gemini')">
            <!-- Gemini-335L camera (Orbbec) -->
            <include file="$(find dynamic_biped)/launch/load_robot_head.launch">
                <arg name="use_orbbec" value="true"/>
                <arg name="all_enable" value="true"/>
            </include>
        </group>
    </group>
    
    <!-- Launch AprilTag detection -->
    <group if="$(arg use_apriltag_detection)">
        <group if="$(eval arg('camera_type') == 'gemini')">
            <!-- Gemini-335L camera AprilTag detection -->
            <include file="$(find apriltag_ros)/launch/continuous_detection.launch">
                <arg name="camera_name" value="/camera"/>
                <arg name="image_topic" value="image_raw"/>
                <arg name="camera_info_topic" value="camera_info"/>
            </include>
        </group>
        
        <group if="$(eval arg('camera_type') == 'realsense')">
            <!-- RealSense camera AprilTag detection -->
            <include file="$(find apriltag_ros)/launch/continuous_detection.launch">
                <arg name="camera_name" value="/camera/color"/>
                <arg name="image_topic" value="image_raw"/>
                <arg name="camera_info_topic" value="camera_info"/>
            </include>
        </group>
        
        <group if="$(eval arg('camera_type') == 'zed')">
            <!-- ZED camera AprilTag detection -->
            <include file="$(find apriltag_ros)/launch/continuous_detection.launch">
                <arg name="camera_name" value="/zed/left"/>
                <arg name="image_topic" value="image_raw"/>
                <arg name="camera_info_topic" value="camera_info"/>
            </include>
        </group>
    </group>
    
    <!-- Launch YOLO detection node -->
    <group if="$(arg use_yolo_detection)">
        <node pkg="nav_detect_grasp" type="yolo_detection_node.py" name="yolo_detection_node" output="screen">
            <param name="model_path" value="$(find nav_detect_grasp)/models/yolov8n.pt"/>
            <param name="confidence_threshold" value="0.5"/>
            <param name="image_topic" value="/camera/image_raw"/>
            <param name="camera_info_topic" value="/camera/camera_info"/>
        </node>
    </group>
    
    <!-- Launch object pose estimator -->
    <node pkg="nav_detect_grasp" type="object_pose_estimator.py" name="object_pose_estimator" output="screen">
        <param name="use_apriltag" value="$(arg use_apriltag_detection)"/>
        <param name="use_yolo" value="$(arg use_yolo_detection)"/>
        <param name="apriltag_topic" value="/robot_tag_info"/>
        <param name="yolo_topic" value="/yolo_detections"/>
        <param name="depth_topic" value="/camera/depth/image_raw"/>
        <param name="camera_info_topic" value="/camera/camera_info"/>
        <param name="output_topic" value="/target_pose"/>
    </node>
    
    <!-- Launch IK node -->
    <include file="$(find motion_capture_ik)/launch/ik_node.launch"/>
    
    <!-- Launch navigation and grasp demo -->
    <node pkg="nav_detect_grasp" type="nav_detect_grasp_demo.py" name="nav_detect_grasp_demo" output="screen">
        <param name="nav_config" value="$(arg nav_config)"/>
        <param name="detection_config" value="$(arg detection_config)"/>
        <param name="grasp_config" value="$(arg grasp_config)"/>
        <param name="use_simulation" value="$(arg use_simulation)"/>
        <param name="use_camera" value="$(arg use_camera)"/>
        <param name="use_apriltag_detection" value="$(arg use_apriltag_detection)"/>
        <param name="use_yolo_detection" value="$(arg use_yolo_detection)"/>
    </node>
    
    <!-- Launch visualization -->
    <group if="$(arg use_visualization)">
        <node pkg="rviz" type="rviz" name="rviz" args="-d $(find nav_detect_grasp)/rviz/nav_detect_grasp.rviz"/>
    </group>
    
</launch> 